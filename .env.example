# Kopieren nach .env und anpassen:  cp .env.example .env
# .env wird nie committet.

# --- Secrets -------------------------------------------------------------
# Leer lassen = werden beim ersten Start zufällig erzeugt und in ./data gespeichert.
# Eigene Werte: mindestens 32 Zeichen, z.B.  openssl rand -hex 48
JWT_SECRET=
ENCRYPTION_SECRET=

# Gültigkeit der Login-Sitzung
JWT_EXPIRES_IN=7d

# --- Netzwerk ------------------------------------------------------------
# Adresse/Port auf dem Host (docker-compose). 0.0.0.0 nur ohne Reverse Proxy im LAN.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000

# Hinter einem Reverse Proxy auf 1 setzen (sonst sehen Rate-Limits nur die Proxy-IP)
TRUST_PROXY=

# Fremde Origins, die die API nutzen dürfen (kommagetrennt). Normalerweise leer.
ALLOWED_ORIGINS=

# Ollama-Server, den der Server-Proxy erreichen darf (optional)
# z.B. http://host.docker.internal:11434  oder  http://192.168.1.50:11434
OLLAMA_URL=

# --- Optional: HTTPS direkt in Node --------------------------------------
# Am einfachsten:  ./scripts/install.sh --tls
# Das erzeugt eine lokale CA samt Zertifikat, hinterlegt die CA im System und in
# Firefox/Chrome (grünes Schloss) und trägt die beiden Pfade hier ein.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Weitere Hostnamen fürs Zertifikat, kommagetrennt (z.B. eine interne Domain)
TLS_HOSTNAMES=
# Alternativ eigenes Zertifikat als PFX-Datei:
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=
